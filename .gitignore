# The private inputs - the classifier's output, the redaction blocklist, the
# tripwire list - must never be committed. They normally live outside the
# checkout; these patterns are the backstop if one is copied in.

# --- private redaction inputs (NEVER commit) -------------------------------
*.PRIVATE.yaml
*.PRIVATE.yml
redaction-blocklist*.yaml
redaction-blocklist*.yml
protocol-map*.yaml
protocol-map*.yml

# --- private working data ---------------------------------------------------
# The public export is generated; the private source is not part of this repo.
/source/
/private/
my-ledger*.yaml
my-ledger*.yml
*.private.json
*.PRIVATE.csv
*.PRIVATE.json
classified*.csv
!tests/fixtures/classified.example.csv

# --- secrets -----------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem

# --- build / tooling --------------------------------------------------------
target/
dist/
build/
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
*.egg-info/

# --- editors / OS -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local notes. NEVER push.
*.local.md

